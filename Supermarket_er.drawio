        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  STATE_TAX ||--o{ STORE : \&quot;taxes\&quot;\n  STORE ||--o{ AISLE : \&quot;has 20-40\&quot;\n  AISLE ||--o{ STORE_STOCK : \&quot;shelves\&quot;\n  ITEM ||--o{ STORE_STOCK : \&quot;stocked as\&quot;\n  STORE ||--o{ RECEIPT : \&quot;rings up\&quot;\n  RECEIPT ||--|{ RECEIPT_ITEM : \&quot;contains\&quot;\n  ITEM ||--o{ RECEIPT_ITEM : \&quot;sold as\&quot;\n  BANK_ACCOUNT ||--o{ BANK_TRANSACTION : \&quot;records\&quot;\n\n  STATE_TAX { char state PK\n              numeric tax_rate }\n  STORE { int store_id PK\n          string name\n          string address\n          string city\n          char state FK\n          int num_aisles }\n  AISLE { int store_id PK\n          int aisle_no PK\n          string category }\n  ITEM { int sku PK\n         string name\n         string category\n         numeric unit_price\n         bool sold_by_weight\n         bool taxable }\n  STORE_STOCK { int store_id PK\n                int sku PK\n                int aisle_no FK\n                numeric qty_on_hand }\n  RECEIPT { int receipt_id PK\n            int store_id FK\n            timestamp receipt_ts\n            string payment_method\n            int bank_account_id\n            numeric subtotal\n            numeric tax\n            numeric total }\n  RECEIPT_ITEM { int receipt_id PK\n                 int line_no PK\n                 int sku FK\n                 numeric quantity\n                 numeric unit_price\n                 numeric tax_amount\n                 numeric line_total }\n  BANK_ACCOUNT { int account_id PK\n                 string owner_name\n                 numeric balance }\n  BANK_TRANSACTION { int tx_id PK\n                     int account_id FK\n                     numeric amount\n                     string tx_type\n                     timestamp tx_timestamp }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="8Pm0F2BLlzHKKjXIaRD